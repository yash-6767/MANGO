# MANGOS Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Supabase Project URL
# Find in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Required: Supabase Anonymous / Public Key  (safe to expose in the browser)
# Find in: Supabase Dashboard → Project Settings → API → anon public key
# ⚠️  Do NOT use the service_role key here — it must never be exposed client-side.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
